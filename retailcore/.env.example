
# SECURITY WARNING: این کلید رو در محیط تولید حتماً عوض کن!
SECRET_KEY=django-insecure-example-key-change-me-in-production

# SECURITY WARNING: در محیط تولید حتماً False کن
DEBUG=True

# لیست هاست‌های مجاز (با کاما جدا کن)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# Database
# ============================================================

# برای SQLite (پیش‌فرض)
DATABASE_URL=sqlite:///db.sqlite3

# برای PostgreSQL (در تولید)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ============================================================
# Media Files
# ============================================================

MEDIA_ROOT=media/