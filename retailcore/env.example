# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (adjust if using PostgreSQL/MySQL instead of SQLite)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/retailcore

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT (SimpleJWT)
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# django-allauth (if using social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (for account verification/password reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
